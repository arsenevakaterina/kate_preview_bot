# Copy to .env for local runs (never commit the real .env).
# On a hosting platform, set these as environment variables in the dashboard.

# Required — get a fresh one from @BotFather (/newbot or /token), then /revoke the old leaked one.
BOT_TOKEN=123456:your-telegram-bot-token

# Optional — chat id where "Confirm and upload" posts the creative.
# Leave unset to post back into the same chat the user is in.
# TARGET_CHAT_ID=-1001234567890
